generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  password           String?
  githubId           String?            @unique
  provider           String?            @default("email")
  avatarUrl          String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  creditLimit        Int                @default(10)
  creditsUsed        Int                @default(0)
  usageResetDate     DateTime           @default(now())
  lastLogin          DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  isVerified         Boolean            @default(false)
  verificationToken  String?
  podcasts           Podcast[]
  summaries          Summary[]
  preferences        UserPreference?
  deepExplanations   DeepExplanation[]
}

model UserPreference {
  id              String       @id @default(uuid())
  userId          String       @unique
  readingLevel    ReadingLevel @default(intermediate)
  tone            Tone         @default(conversational)
  defaultDepth    Depth        @default(standard)
  defaultLanguage String       @default("en")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Podcast {
  id            String        @id @default(uuid())
  userId        String
  blogUrl       String
  scrapedText   String?
  script        String?
  audioUrl      String?
  status        PodcastStatus @default(processing)
  progress      Int           @default(0)
  audioDuration Float?
  creditsUsed   Int           @default(0)
  errorMessage  String?
  failedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Summary {
  id           String        @id @default(uuid())
  userId       String
  sourceUrl    String
  type         SummaryType
  content      String
  rawContent   String?
  concepts     Json?
  audioUrl     String?
  audioStatus  AudioStatus?
  creditsUsed  Int           @default(0)
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  summaryId String
  role      String
  content   String
  createdAt DateTime @default(now())
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId])
}

model DeepExplanation {
  id            String      @id @default(uuid())
  userId        String
  topic         String
  mode          ExplainMode
  content       String      @db.Text
  sourceContent String?     @db.Text
  followUps     Json?
  creditsUsed   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PodcastStatus {
  processing
  scraping
  scraped
  generating_script
  script_generated
  generating_audio
  completed
  failed
}

enum SummaryType {
  youtube
  web
  pdf
  text
}

enum AudioStatus {
  pending
  generating
  completed
  failed
}

enum ReadingLevel {
  beginner
  intermediate
  expert
}

enum ExplainMode {
  EASY
  INTUITIVE
  DEEP
}

enum Tone {
  casual
  conversational
  professional
  academic
}

enum Depth {
  quick
  standard
  detailed
}
