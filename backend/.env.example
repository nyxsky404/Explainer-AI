# Explainer AI — Backend Environment Variables
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-very-long-random-secret-here"
NODE_ENV="development"  # development | production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="http://localhost:5173"

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=""   # Required: https://openrouter.ai/keys
GEMINI_API_KEY=""       # Required: https://aistudio.google.com/app/apikey
MODEL="openai/gpt-oss-120b:free"  # OpenRouter model for all text generation (change to swap models globally)
GEMINI_TEXT_MODEL="gemini-2.5-flash"        # Gemini model for YouTube summarization
GEMINI_SCRIPT_MODEL="gemini-3-flash-preview" # Gemini model for script/gossip generation
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview" # Gemini model for audio TTS

# ── OAuth ─────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Storage (Supabase) ────────────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""  # Use Service Role key (not anon key)

# ── Cache / Queue ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Email / SMTP (production only) ────────────────────────────────────────────
# In development, an Ethereal test account is auto-created — no config needed.
# In production, set all of the following:
SMTP_HOST=""            # e.g. smtp.resend.com | smtp.sendgrid.net
SMTP_PORT="587"
SMTP_SECURE="false"     # true for port 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""            # e.g. noreply@yourapp.com

# ── ElevenLabs / Deepgram (audio generation) ──────────────────────────────────
ELEVENLABS_API_KEY=""   # Optional: for podcast TTS
DEEPGRAM_API_KEY=""     # Optional: for summary TTS

# ── Web Scraping ───────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=""    # Required for web URL summarization: https://firecrawl.dev
